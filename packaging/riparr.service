[Unit]
Description=Riparr — disc ripping appliance
Documentation=https://github.com/jackharvest/riparr
After=network-online.target
Wants=network-online.target
# The library mount is a convenience, never a dependency: Wants= rather than Requires=,
# so a sleeping NAS degrades rips to staging on the card instead of refusing to start.
Wants=riparr-library.service
After=riparr-library.service

[Service]
Type=simple
User=riparr
Group=riparr
# Every Riparr unit lives in one slice, so one drop-in on riparr.slice can throttle the
# whole box's rip work at once. See packaging/riparr.slice.
Slice=riparr.slice
# The optical drive is owned by root:cdrom, and the service has to read it.
#
# `spi` is deliberately NOT listed here, even though the status LED needs it. A group
# named in SupplementaryGroups= that does not exist makes systemd refuse to start the
# unit, and `spi` does not exist until SPI has been enabled in the device tree — which
# on most boards it never is. install.sh adds the account to `spi` when the group is
# there, and systemd picks up the account's own groups anyway; that path costs nothing
# when it is absent.
SupplementaryGroups=cdrom
# /opt/riparr/current is a root-owned symlink to the verified release in
# /opt/riparr/releases/<version>; the service can read it and cannot write it. The
# in-app updater asks root to move the link (see riparr-update.path).
WorkingDirectory=/opt/riparr/current/server

# The defaults, overridden by whatever the preparer wrote to the boot partition and
# then by /etc/default/riparr (the operator's file on a host that is not an
# appliance). Later assignments win, so the files beat these lines when they exist.
#
# RIPARR_HOST=0.0.0.0 keeps the appliance reachable from the LAN by name. Set it to
# 127.0.0.1 to listen on loopback only and put a reverse proxy or `tailscale serve`
# in front -- see docs/hardened-deployment.md.
Environment=RIPARR_HOST=0.0.0.0
Environment=RIPARR_PORT=9797
Environment=RIPARR_DB=/var/lib/riparr/riparr.db
Environment=PYTHONUNBUFFERED=1
# The service account may be the login account the Imager created, whose home is under
# /home — which ProtectHome= hides. Point HOME at the state directory instead, so
# ~/.MakeMKV resolves somewhere that exists and is writable.
Environment=HOME=/var/lib/riparr
EnvironmentFile=-/boot/firmware/riparr.conf
EnvironmentFile=-/boot/riparr.conf
EnvironmentFile=-/etc/default/riparr

ExecStart=/opt/riparr/current/.venv/bin/python -m uvicorn riparr.main:app \
          --host ${RIPARR_HOST} --port ${RIPARR_PORT}

# The cable gets pulled and discs misbehave; staying up is the whole job (D4).
Restart=always
RestartSec=3

# ── the sandbox ──
# Tightened 2026-11-05 from "ProtectSystem=full and four lines" to the list below.
# Every directive here was weighed against what the service actually does -- read a
# USB optical drive with MakeMKV, cd-paranoia and eject; write the staging directory,
# the state directory and the mounted library shares; talk to the LAN; and, on some
# boards, drive an SPI status LED and ask the firmware for the temperature. What had
# to stay open is marked, with why. The score this earns is held by CI
# (packaging/security-score.sh); a directive lost by accident moves it.
#
# How it was checked: the unit parses and scores under systemd-analyze; a syscall
# trace of the service and its children through the whole test suite stays inside
# @system-service; and the device, path and address-family needs were taken from the
# code. It has NOT yet been run end to end on a board with a real drive under these
# settings -- docs/security.md says how to, and packaging/examples/sandbox-off.conf is
# the one-file way back if a board turns up something this missed.
NoNewPrivileges=yes
PrivateTmp=yes
# Everything is read-only except what is listed. The leading '-' matters: on stock
# Raspberry Pi OS the dedicated staging partition (D4) does not exist yet, and systemd
# refuses to start a unit whose ReadWritePaths= names a missing directory. Without it,
# first boot ends with a service that never starts.
#
# /srv as a whole, not /srv/library alone: every additional share is mounted beside
# it at /srv/library-<id> (tools/mount-library.sh), and a mount made after the service
# started propagates into its namespace with its own flags.
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/riparr -/srv/staging -/srv
StateDirectory=riparr
# /run/riparr, owned by the service account. This is how the unprivileged service asks
# the root-side helpers to run (the .path units watch it). Root answers in its own
# /run/riparr-status, which this service can read and never write. Preserve=yes so a
# restart mid-build does not delete the request the page is reading.
RuntimeDirectory=riparr
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
# New files are group-readable, world-nothing. The database is 0600 by its own hand;
# rips written through a CIFS mount take the mount's file_mode, not this.
UMask=0027

# Devices: nothing, then exactly these. By kernel class rather than by path, because a
# USB drive plugged in after the service started would not exist at the moment a path
# is resolved.
#   block-sr     the optical drive itself (/dev/sr0): MakeMKV, cd-paranoia, blkid, eject
#   char-sg      SCSI generic (/dev/sg0): MakeMKV's drive enumeration and pass-through
#   char-spidev  the SPI status LED (riparr/led.py), where the board has one
#   char-vchiq   `vcgencmd` on a Raspberry Pi: temperature and throttling
# A class that does not exist on a board (no SPI, no VideoCore) is logged by systemd
# and ignored; it does not stop the unit. GPIO is not opened by the service today; a
# board that needs it adds `DeviceAllow=char-gpiochip rw` in a drop-in.
DevicePolicy=closed
DeviceAllow=block-sr rw
DeviceAllow=char-sg rw
DeviceAllow=char-spidev rw
DeviceAllow=char-vchiq rw

ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
# Other users' processes are hidden. Not ProcSubset=pid: the service reads
# /proc/device-tree/model to know it is on a board at all.
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
# AF_NETLINK stays: `iw` and `ip`, which the status page runs for the Wi-Fi link and
# the address, talk to the kernel over netlink. AF_UNIX for the wpa_supplicant control
# socket, D-Bus and syslog; AF_INET/6 for the share, the NAS and GitHub.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# @system-service covers Python, uvicorn, MakeMKV's SG_IO ioctls, cd-paranoia and the
# encoders; it excludes mounting, rebooting, module loading, raw I/O ports and the
# obsolete calls. Refused calls fail with EPERM rather than killing the process, so a
# tool that probes for something exotic degrades instead of dying.
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
# The service holds no capability and can acquire none; everything privileged goes
# through the one-way doors.
CapabilityBoundingSet=
#
# Deliberately NOT set:
#   MemoryDenyWriteExecute  makemkvcon is a closed binary this cannot vouch for
#   PrivateDevices          the whole job is a device
#   PrivateNetwork          the whole job is a NAS
#   ProcSubset=pid          /proc/device-tree is how the box knows it is a box

[Install]
WantedBy=multi-user.target
