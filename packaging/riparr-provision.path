[Unit]
Description=Watch for a Riparr request to apply system changes after an update
Documentation=https://github.com/jackharvest/riparr

[Path]
# The in-app updater replaces /opt/riparr but cannot write /etc/systemd/system — it
# runs as the riparr user, and must keep running as the riparr user. This is the same
# one-way door as riparr-wifi.path: the service can create one empty file in its own
# runtime directory, and that is the entire interface.
#
# Nothing in the file is read. The request means exactly "apply the units that are in
# /opt/riparr/packaging now". That tree is root's: the root-side update helper put it
# there after checking the release's checksum and provenance, and apply-system.sh
# refuses to install anything in it that is not root-owned and closed to other
# writers. So a compromised service can ask for the code root already verified to be
# installed, and nothing else.
PathExists=/run/riparr/provision.request

[Install]
WantedBy=multi-user.target
