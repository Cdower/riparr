[Unit]
Description=Apply Riparr system changes after an in-app update
Documentation=https://github.com/jackharvest/riparr

[Service]
Slice=riparr.slice
Type=oneshot
ExecStartPre=/bin/rm -f /run/riparr/provision.request
# Root's own copy, and only that. This unit used to refresh it first from
# /opt/riparr/packaging -- which the service account owned, so the service could
# rewrite the script root was about to run. The tree is root's now and the update
# helper (riparr-update.sh) refreshes this copy from each verified release; the copy
# also refreshes itself from the verified tree as its last step, so a box is current
# from the provision after an update.
ExecStart=/usr/local/lib/riparr/apply-system.sh
TimeoutStartSec=120

# Not sandboxed, for the reason recorded in riparr-wifi.service: this writes
# /etc/systemd/system and calls systemctl, and a namespaced unit would do both
# privately and invisibly.
